# Copia este archivo a .env y completa los valores.

# PostgreSQL (Neon o Supabase). DATABASE_URL puede ser la cadena pooled;
# DIRECT_URL la directa (solo la usan las migraciones).
DATABASE_URL="postgresql://user:password@host:5432/cai?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/cai?sslmode=require"

# Firma las cookies de dispositivo y de sesión. Genera con: openssl rand -base64 32
SESSION_SECRET=""

# Web Push (pnpm vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:cai@uc.cl"

# Envío del código de verificación con Resend (https://resend.com).
# En local puedes dejarlo vacío: el código se imprime en la consola de `pnpm dev`.
# Con el remitente de prueba onboarding@resend.dev, Resend solo entrega al correo
# de tu propia cuenta Resend; para enviar a cualquiera verifica un dominio.
RESEND_API_KEY=""
EMAIL_FROM="CAi <onboarding@resend.dev>"

# Protege /api/cron/digest
CRON_SECRET=""

# Opcional: origen absoluto de la app (si no, se usa VERCEL_URL o localhost)
# NEXT_PUBLIC_APP_URL="https://tu-app.vercel.app"
