# Copia este archivo a .env y completa los valores.

# PostgreSQL (Neon o Supabase). DATABASE_URL puede ser la cadena pooled;
# DIRECT_URL la directa (solo la usan las migraciones).
DATABASE_URL="postgresql://user:password@host:5432/cai?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/cai?sslmode=require"

# Firma las cookies de dispositivo y de sesión. Genera con: openssl rand -base64 32
SESSION_SECRET=""

# Web Push (pnpm vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:cai@uc.cl"

# Envío del código de verificación. Si dejas todo vacío, en local el código se
# imprime en la consola de `pnpm dev`. Se usa el primer proveedor con clave:
#
# 1) Brevo (https://www.brevo.com), gratis y sin dominio propio. La clave solo
#    necesita el permiso "Emails transaccionales: Todos". EMAIL_FROM debe ser un
#    correo verificado en Brevo (Senders).
BREVO_API_KEY=""
#
# 2) Resend (https://resend.com), clave con "Sending access". Sin dominio
#    verificado solo entrega al correo de tu propia cuenta Resend.
RESEND_API_KEY=""
#
# Remitente: "Nombre <correo>". Obligatorio con Brevo; con Resend, si está vacío,
# se usa onboarding@resend.dev.
EMAIL_FROM="CAi <tu-correo-verificado@gmail.com>"

# Protege /api/cron/digest
CRON_SECRET=""

# Opcional: origen absoluto de la app (si no, se usa VERCEL_URL o localhost)
# NEXT_PUBLIC_APP_URL="https://tu-app.vercel.app"
